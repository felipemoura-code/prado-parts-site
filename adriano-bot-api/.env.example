# Nunca preencher as credenciais no GitHub nem enviar os valores em capturas de tela.
# Este exemplo inicia o bot totalmente DESATIVADO até a integração autorizada.
NODE_ENV=production
PORT=3000
BOT_ACTIVE=false
BOT_MODE=test
PRODUCTION_APPROVED=false
TEST_ALLOWED_NUMBERS=
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v24.0
ADMIN_API_KEY=

# Teste Twilio Sandbox clássico (não ativar até configurar webhook + segredo)
TWILIO_SANDBOX_ACTIVE=false
TWILIO_AUTH_TOKEN=
TWILIO_ALLOWED_NUMBERS=
# Necessário ajustar quando houver domínio definitivo
# TWILIO_WEBHOOK_URL=https://bot.seudominio.com.br/twilio-sandbox
